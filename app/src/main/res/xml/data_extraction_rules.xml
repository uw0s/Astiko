<?xml version="1.0" encoding="utf-8"?>
<!-- Same exclusion as backup_rules.xml (see its comment) for cloud backup
     and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline_cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline_cache" />
    </device-transfer>
</data-extraction-rules>
